# DockScope Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.

# ==============================================================================
# Application Settings
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
APP_NAME=DockScope
APP_TAGLINE="Monitor. Analyze. Control."
APP_VERSION=0.1.0

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=dockscope-insecure-dev-secret-key-change-in-production-min32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie settings for browser session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS Settings (JSON-encoded array or comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000"]

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=dockscope
POSTGRES_PASSWORD=dockscope_secure_password
POSTGRES_DB=dockscope

# Database URL for async SQLAlchemy operations
# In Docker compose: postgresql+psycopg://dockscope:dockscope_secure_password@db:5432/dockscope
# In local host development: postgresql+psycopg://dockscope:dockscope_secure_password@127.0.0.1:5432/dockscope
DATABASE_URL=postgresql+psycopg://dockscope:dockscope_secure_password@127.0.0.1:5432/dockscope

# ==============================================================================
# Network & Reverse Proxy (Nginx)
# ==============================================================================
DOCKSCOPE_PORT=3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=80
